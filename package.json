{
  "name": "dsh-web-search-codex-020",
  "version": "0.2.0-rc.2",
  "description": "OpenAI Responses native web search with desktop configuration for DeepSeek Harness 0.2.0-rc.2",
  "type": "module",
  "license": "MIT",
  "author": "CanMing",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib/*.js", "client.js", "scripts/build-client.mjs", "cordis.patch.yml", "README.md", "CHANGELOG.md", "VALIDATION.md", "LICENSE", "NOTICE"],
  "engines": {"node": ">=22.19.0"},
  "keywords": ["deepseek-harness", "dsh", "web-search", "openai", "responses", "sub2api", "codex"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-api-remotes"],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-isolation=none --test-concurrency=1 test/*.test.js",
    "prepack": "node scripts/build-client.mjs && node scripts/check.mjs"
  },
  "dependencies": {"@deepseek-ai/schemastery": "~3.18.4"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "js-yaml": "^4.1.0"
  }
}
